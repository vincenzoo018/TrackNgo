APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail account TrackNGo sends from. "log" only writes emails to storage/logs/laravel.log.
# Gmail: MAIL_MAILER=smtp, MAIL_SCHEME=smtp (STARTTLS), MAIL_HOST=smtp.gmail.com, MAIL_PORT=587,
# MAIL_USERNAME / MAIL_FROM_ADDRESS = the Gmail address, MAIL_PASSWORD = a Google App Password (needs 2-Step
# Verification; never the normal Google password). Put the real password only in your local .env.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=your-sending-account@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_FROM_ADDRESS="your-sending-account@gmail.com"
MAIL_FROM_NAME="TrackNGo Mati"
MAIL_TIMEOUT=20

# Email notifications: off = events are logged as "disabled" and nothing is sent
TRACKNGO_EMAIL_ENABLED=false
TRACKNGO_EMAIL_MAX_PER_DAY=50
TRACKNGO_EMAIL_MAX_PER_RECIPIENT_PER_DAY=10
TRACKNGO_EMAIL_MAX_ATTEMPTS=3
# Placeholder domains of demo accounts that must never be emailed, comma separated (e.g. mati.com)
TRACKNGO_EMAIL_BLOCKED_DOMAINS=
# Address that email links (tracking page, documents) point to, e.g. http://192.168.1.5:8000; blank = APP_URL
TRACKING_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cloudflare Turnstile captcha on login / forgot password (put the real keys only in your local .env).
# It runs only on the hostnames added to the widget in the Cloudflare dashboard (never on an IP address): add
# "localhost" there for local testing and the live domain before deploying. Without keys, or when Cloudflare
# cannot be reached, nobody can log in (fails closed). Cloudflare's test keys (site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA) always pass and are refused when APP_ENV=production.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Semaphore SMS (put the real key only in your local .env)
SEMAPHORE_API_KEY=your_semaphore_api_key_here
SEMAPHORE_SENDER_NAME=

# SMS switches: dry run always wins; set SMS_ENABLED=true and SMS_DRY_RUN=false for real SMS
SMS_ENABLED=false
SMS_DRY_RUN=true
SMS_MAX_PER_USER_PER_DAY=10
SMS_MAX_PER_DOCUMENT=10
SMS_MIN_INTERVAL_SECONDS=60
SMS_MAX_PER_DAY=200
SMS_MAX_ATTEMPTS=3
